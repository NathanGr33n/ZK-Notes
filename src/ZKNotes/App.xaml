<Application x:Class="ZKNotes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZKNotes"
             xmlns:conv="clr-namespace:ZKNotes.Converters">
    <Application.Resources>
        <!-- Converters -->
        <conv:PageVisibilityConverter x:Key="PageVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!--
            Style aligned with STYLE.md:
            light editorial UI (off-white background), jet-black text,
            with accent purple used sparingly for emphasis and interactivity.
        -->

        <!-- Base palette -->
        <Color x:Key="ColorBackground">#0F1115</Color>
        <Color x:Key="ColorSidebar">#12141A</Color>
        <Color x:Key="ColorSurface">#171A22</Color>
        <Color x:Key="ColorSurfaceHover">#1E2230</Color>
        <Color x:Key="ColorSurfacePressed">#24293A</Color>
        <!-- subtle purple tint for selection (still very dark) -->
        <Color x:Key="ColorSelected">#241B2C</Color>
        <Color x:Key="ColorBorder">#2B3240</Color>
        <Color x:Key="ColorForeground">#EDEFF5</Color>
        <Color x:Key="ColorForegroundMuted">#A9B0BE</Color>
        <!-- Accent purple from STYLE.md -->
        <Color x:Key="ColorAccent">#9B59B6</Color>
        <Color x:Key="ColorAccentHover">#7D3C98</Color>
        <Color x:Key="ColorDanger">#E74C3C</Color>

        <!-- Brushes (existing keys preserved) -->
        <!-- Fallback solid background color -->
        <SolidColorBrush x:Key="BackgroundColorBrush" Color="{StaticResource ColorBackground}"/>

        <!-- App background image -->
        <ImageBrush x:Key="BackgroundBrush"
                    ImageSource="pack://application:,,,/Assets/BlackBackground.webp"
                    Stretch="UniformToFill"
                    TileMode="None"
                    AlignmentX="Center" AlignmentY="Center"/>

        <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource ColorSidebar}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource ColorSurfaceHover}"/>
        <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource ColorSurfacePressed}"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource ColorSelected}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ColorForeground}"/>
        <SolidColorBrush x:Key="SecondaryForeground" Color="{StaticResource ColorForegroundMuted}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}"/>

        <!-- Typography / sizing -->
        <FontFamily x:Key="AppFont">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
        <CornerRadius x:Key="CornerRadiusSm">4</CornerRadius>
        <CornerRadius x:Key="CornerRadiusMd">6</CornerRadius>

        <!-- Global text defaults -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>

        <!-- Inputs -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.25"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Transparent editor-style inputs (outline only) -->
        <Style x:Key="TransparentOutlineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CornerRadiusSm}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEC6B5D"/>
                    <Setter Property="BorderBrush" Value="#FFEC6B5D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Lists -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource CornerRadiusSm}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
