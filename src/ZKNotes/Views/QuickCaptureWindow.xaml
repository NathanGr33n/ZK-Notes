<Window x:Class="ZKNotes.Views.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Capture" Height="320" Width="450"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBox x:Name="TitleBox" Grid.Row="0"
                 FontSize="16" FontWeight="SemiBold" Padding="8,6"
                 Background="{StaticResource SurfaceBrush}"
                 Foreground="{StaticResource ForegroundBrush}"
                 CaretBrush="{StaticResource ForegroundBrush}"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 Tag="Title…"/>

        <!-- Content -->
        <TextBox x:Name="ContentBox" Grid.Row="1" Margin="0,8,0,0"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Code, Consolas, Courier New"
                 FontSize="13" Padding="8"
                 Background="{StaticResource SurfaceBrush}"
                 Foreground="{StaticResource ForegroundBrush}"
                 CaretBrush="{StaticResource ForegroundBrush}"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 Tag="Content… (use #tags and [[links]])"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="12,6" Margin="4,0"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource ForegroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Cursor="Hand"/>
            <Button Content="Save Note" Click="Save_Click" Padding="12,6" Margin="4,0"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
