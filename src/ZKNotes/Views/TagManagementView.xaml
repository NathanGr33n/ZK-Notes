<UserControl x:Class="ZKNotes.Views.TagManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Tag list -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Tags" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,8"/>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding TagManagement.StatusText}"
                           Foreground="{StaticResource SecondaryForeground}" FontSize="11"
                           Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>

                <ListBox x:Name="TagsList" ItemsSource="{Binding TagManagement.Tags}"
                         SelectedItem="{Binding TagManagement.SelectedTag, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}"
                                           Foreground="{StaticResource SecondaryForeground}" FontSize="11"/>
                                <TextBlock Text="{Binding Tag, StringFormat=\#{0}}"
                                           Foreground="{StaticResource ForegroundBrush}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Details -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Tag management" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <Button Content="Refresh" Click="Refresh_Click" Padding="8,4"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <!-- Rename -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Rename" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <DockPanel>
                        <TextBox Text="{Binding TagManagement.RenameTo, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="220" Margin="0,0,8,0"/>
                        <Button Content="Rename" Click="Rename_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="10,6"/>
                    </DockPanel>
                    <TextBlock Text="Renames inline #tags across all notes." FontSize="11"
                               Foreground="{StaticResource SecondaryForeground}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Merge -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Merge" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <DockPanel>
                        <ComboBox ItemsSource="{Binding TagManagement.MergeTargets}"
                                  SelectedItem="{Binding TagManagement.SelectedMergeTarget, Mode=TwoWay}"
                                  DisplayMemberPath="Tag" MinWidth="220" Margin="0,0,8,0"/>
                        <Button Content="Merge" Click="Merge_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="10,6"/>
                    </DockPanel>
                    <TextBlock Text="Merges the selected tag into the target tag." FontSize="11"
                               Foreground="{StaticResource SecondaryForeground}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Notes with tag -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Notes with tag" FontWeight="SemiBold" FontSize="13"
                               Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding TagManagement.NotesWithTag}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="6" Margin="0,2">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Open" Padding="8,4" Margin="8,0,0,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="OpenNote_Click" Tag="{Binding}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="10" Foreground="{StaticResource SecondaryForeground}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:MMM dd} · {1}">
                                                        <Binding Path="LastEdit"/>
                                                        <Binding Path="Id"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
