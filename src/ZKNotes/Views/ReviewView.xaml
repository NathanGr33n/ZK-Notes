<UserControl x:Class="ZKNotes.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Weekly Review" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource ForegroundBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Refresh" Click="Refresh_Click" Padding="8,4"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="1" Text="{Binding Review.ReviewStatus}"
                   Foreground="{StaticResource SecondaryForeground}"
                   FontSize="12" Margin="0,0,0,8"/>

        <!-- Review notes list -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Review.ReviewNotes}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            Padding="12" Margin="0,4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="Open" Click="OpenNote_Click" Tag="{Binding}"
                                        Padding="8,4" Margin="2"
                                        Background="{StaticResource AccentBrush}" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                <Button Content="Mark Reviewed" Click="MarkReviewed_Click" Tag="{Binding}"
                                        Padding="8,4" Margin="2"
                                        Background="{StaticResource SurfaceBrush}"
                                        Foreground="{StaticResource ForegroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Cursor="Hand" FontSize="11"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource ForegroundBrush}"/>
                                <TextBlock Text="{Binding Snippet}" FontSize="11"
                                           Foreground="{StaticResource SecondaryForeground}"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}Last edited: {0:MMM dd} · {1}">
                                            <Binding Path="LastEdit"/>
                                            <Binding Path="Id"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
