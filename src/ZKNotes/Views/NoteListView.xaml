<UserControl x:Class="ZKNotes.Views.NoteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:helpers="clr-namespace:ZKNotes.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- Note list panel -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="All notes" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}" Margin="12,12,12,8"/>

                <ListBox x:Name="NotesList" ItemsSource="{Binding Notes}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource ForegroundBrush}"
                         SelectionChanged="NotesList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Snippet}" FontSize="11"
                                           Foreground="{StaticResource SecondaryForeground}"
                                           TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock FontSize="10" Foreground="{StaticResource AccentBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:MMM dd} · {1}">
                                                <Binding Path="LastEdit"/>
                                                <Binding Path="Id"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Margin" Value="4,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Editor / Preview area -->
        <Grid Grid.Column="1" Margin="16,12"
              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title and controls -->
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Save" Command="{Binding Editor.SaveNowCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="12,6" Margin="4,0"/>
                    <Button Content="Delete" Command="{Binding DeleteNoteCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="12,6" Margin="4,0"/>
                </StackPanel>
                <TextBox Text="{Binding Editor.Title, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TransparentOutlineTextBoxStyle}"
                         FontSize="20" FontWeight="Bold"
                         Background="Transparent"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Padding="10,8"
                         CaretBrush="{StaticResource ForegroundBrush}"/>
            </DockPanel>

            <!-- Tags display -->
            <TextBlock Grid.Row="1" Text="{Binding Editor.TagsDisplay}"
                       Foreground="{StaticResource AccentBrush}" FontSize="11"
                       Margin="0,4,0,8"/>

            <!-- Editor -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid>
                    <avalonedit:TextEditor x:Name="ContentEditor"
                        helpers:AvalonEditBinding.Text="{Binding Editor.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FontFamily="Cascadia Code, Consolas, Courier New"
                        FontSize="13"
                        Background="Transparent"
                        Foreground="{StaticResource ForegroundBrush}"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        ShowLineNumbers="False"/>

                    <!-- Link suggestions ([[... -->
                    <Popup x:Name="LinkSuggestionsPopup"
                           IsOpen="{Binding Editor.ShowLinkSuggestions}"
                           PlacementTarget="{Binding ElementName=ContentEditor}"
                           Placement="Relative"
                           AllowsTransparency="True"
                           StaysOpen="True">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="4"
                                MaxWidth="360" MaxHeight="260">
                            <ListBox x:Name="LinkSuggestionsList"
                                     ItemsSource="{Binding Editor.LinkSuggestions}"
                                     SelectedItem="{Binding Editor.SelectedLinkSuggestion, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Id}" FontSize="10"
                                                       Foreground="{StaticResource SecondaryForeground}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>

                    <!-- Tag suggestions (#... -->
                    <Popup x:Name="TagSuggestionsPopup"
                           IsOpen="{Binding Editor.ShowTagSuggestions}"
                           PlacementTarget="{Binding ElementName=ContentEditor}"
                           Placement="Relative"
                           AllowsTransparency="True"
                           StaysOpen="True">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="4"
                                MaxWidth="260" MaxHeight="260">
                            <ListBox x:Name="TagSuggestionsList"
                                     ItemsSource="{Binding Editor.TagSuggestions}"
                                     SelectedItem="{Binding Editor.SelectedTagSuggestion, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat=\#{0}}" FontSize="12"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   Margin="6,4"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </Grid>

        <!-- Backlinks panel -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Backlinks" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}" Margin="12,12,12,8"/>

                <ListBox x:Name="BacklinksList" ItemsSource="{Binding Backlinks}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource ForegroundBrush}"
                         SelectionChanged="Backlinks_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:MMM dd} · {1}">
                                            <Binding Path="LastEdit"/>
                                            <Binding Path="Id"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock DockPanel.Dock="Bottom" Text="No backlinks" FontSize="11"
                           Foreground="{StaticResource SecondaryForeground}"
                           Margin="12,8" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Backlinks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Column="1" Text="Select or create a note to begin"
                   Foreground="{StaticResource SecondaryForeground}"
                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis},
                                ConverterParameter=Invert}"/>
    </Grid>
</UserControl>
