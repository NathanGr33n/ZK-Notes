<Window x:Class="ZKNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ZKNotes.ViewModels"
        xmlns:views="clr-namespace:ZKNotes.Views"
        mc:Ignorable="d"
        Title="ZK-Notes" Height="700" Width="1100" MinHeight="500" MinWidth="800"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App title -->
                <TextBlock DockPanel.Dock="Top" Text="ZK-Notes" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="16,16,16,8"/>

                <!-- Theme toggle at bottom -->
                <Button DockPanel.Dock="Bottom" Content="🌙 Toggle Theme" Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="8,4,8,4" FontSize="12"/>

                <!-- Status bar at bottom -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}"
                           Foreground="{StaticResource SecondaryForeground}" FontSize="11"
                           Margin="16,8" TextTrimming="CharacterEllipsis"/>

                <StackPanel Margin="8,8">
                    <!-- New Note button -->
                    <Button Content="Create note" Command="{Binding CreateNoteCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="4" Padding="10,7" FontSize="13"/>

                    <Button Content="&#xE8A7;  Fleeting note" Command="{Binding CreateFleetingNoteCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,6,4,2" FontSize="13"/>

                    <Button Content="&#xE787;  Journal note" Command="{Binding CreateJournalNoteCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,2" FontSize="13"/>

                    <Border Margin="4,8,4,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"/>

                    <TextBlock Text="Templates" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryForeground}" Margin="4,0,4,6"/>

                    <ComboBox ItemsSource="{Binding TemplatesList}"
                              SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                              Background="{StaticResource SurfaceBrush}"
                              Foreground="{StaticResource ForegroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              Margin="4,0,4,6"/>

                    <Button Content="Create from template" Command="{Binding CreateFromTemplateCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,0,4,12" FontSize="13"/>

                    <!-- Navigation buttons -->
                    <Button Content="&#xE70B;  Notes" Tag="Notes" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,12,4,2" FontSize="13"/>
                    <Button Content="&#xE774;  Graph" Tag="Graph" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,2" FontSize="13"/>
                    <Button Content="&#xE721;  Search" Tag="Search" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,2" FontSize="13"/>
                    <Button Content="&#xE8EC;  Tags" Tag="Tags" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,2" FontSize="13"/>
                    <Button Content="&#xE7BF;  Review" Tag="Review" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,2" FontSize="13"/>
                    <Button Content="&#xE9D2;  Insights" Tag="Insights" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,2" FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Column="1">
            <views:NoteListView x:Name="NoteListPanel"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisConverter}, ConverterParameter=Notes}"/>
            <views:GraphView x:Name="GraphPanel"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisConverter}, ConverterParameter=Graph}"/>
            <views:SearchView x:Name="SearchPanel"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisConverter}, ConverterParameter=Search}"/>
            <views:TagManagementView x:Name="TagsPanel"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisConverter}, ConverterParameter=Tags}"/>
            <views:ReviewView x:Name="ReviewPanel"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisConverter}, ConverterParameter=Review}"/>
            <views:InsightsView x:Name="InsightsPanel"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisConverter}, ConverterParameter=Insights}"/>
        </Grid>
    </Grid>
</Window>
