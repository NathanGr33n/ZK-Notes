<Window x:Class="ZKNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ZKNotes.ViewModels"
        xmlns:views="clr-namespace:ZKNotes.Views"
        mc:Ignorable="d"
        Title="ZK-Notes" Height="700" Width="1100" MinHeight="500" MinWidth="800"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App title -->
                <TextBlock DockPanel.Dock="Top" Text="ZK-Notes" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="16,16,16,8"/>

                <!-- Status bar at bottom -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}"
                           Foreground="{StaticResource SecondaryForeground}" FontSize="11"
                           Margin="16,8" TextTrimming="CharacterEllipsis"/>

                <StackPanel Margin="8,8">
                    <!-- New Note button -->
                    <Button Content="+ New Note" Command="{Binding CreateNoteCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="4" Padding="10,7" FontSize="13"/>

                    <!-- Navigation buttons -->
                    <Button Content="&#xE70B;  Notes" Tag="Notes" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,12,4,2" FontSize="13"/>
                    <Button Content="&#xE774;  Graph" Tag="Graph" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,2" FontSize="13"/>
                    <Button Content="&#xE721;  Search" Tag="Search" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,2" FontSize="13"/>
                    <Button Content="&#xE7BF;  Review" Tag="Review" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,2" FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Column="1">
            <views:NoteListView x:Name="NoteListPanel"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisConverter}, ConverterParameter=Notes}"/>
            <views:GraphView x:Name="GraphPanel"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisConverter}, ConverterParameter=Graph}"/>
            <views:SearchView x:Name="SearchPanel"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisConverter}, ConverterParameter=Search}"/>
            <views:ReviewView x:Name="ReviewPanel"
                Visibility="{Binding CurrentPage, Converter={StaticResource PageVisConverter}, ConverterParameter=Review}"/>
        </Grid>
    </Grid>
</Window>
